# ===================== API =====================
# Puerto del servidor Express
PORT=5000

# development | production
NODE_ENV=development

# Cadena de conexión de MongoDB.
# - MongoDB Atlas: mongodb+srv://usuario:clave@cluster.mongodb.net/novashop
# - Local:         mongodb://127.0.0.1:27017/novashop
# (si lo dejas vacío, `npm run dev:memory` levanta una BD temporal en memoria)
MONGODB_URI=

# Origen permitido para CORS (frontend Vite)
CLIENT_ORIGIN=http://localhost:5173

# ===================== JWT =====================
# ¡Cámbialos en producción! Genera con: openssl rand -hex 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===================== PAGOS =====================
# Claves de prueba de Stripe (https://dashboard.stripe.com/test/apikeys).
# Si las dejas vacías, la tienda entra en MODO DEMO (sin cargos reales).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Fuerza el modo demo (true/false). Por defecto es true si no hay clave de Stripe.
DEMO_PAYMENTS=

# Moneda y reglas de envío/impuestos
CURRENCY=usd
SHIPPING_COST=9.99
FREE_SHIPPING_THRESHOLD=100
TAX_RATE=0.18

# ===================== SEED =====================
SEED_ADMIN_NAME=Admin Demo
SEED_ADMIN_EMAIL=admin@shop.com
SEED_ADMIN_PASSWORD=Admin123!
